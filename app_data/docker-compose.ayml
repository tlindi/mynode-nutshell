version: "3"
services:
  mint:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: mint
    ports:
      - "3338:3338"
    env_file:
      - .env
    volumes:
      - mint_data:/app/data
    command: ["poetry", "run", "mint"]

  wallet:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: wallet
    ports:
      - "4448:4448"
    depends_on:
      - mint
    env_file:
      - .env
    volumes:
      - wallet_data:/app/data
    command: ["poetry", "run", "cashu", "-d"]

volumes:
  mint_data:
  wallet_data:
